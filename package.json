{
  "name": "direct-pump-extension",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "check": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:sites": "node scripts/verify-sites.mjs",
    "verify": "npm run check && npm test && npm run build",
    "verify:browser": "npm run verify && npm run test:sites"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@pump-fun/pump-sdk": "2.0.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@raydium-io/raydium-sdk-v2": "0.2.73-alpha",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.15.30",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wxt": "0.21.4"
  }
}
